{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Customers",
  "version": "1.1.0",
  "identifier": "local.leadgenerator.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Customers",
        "width": 1360,
        "height": 860,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#1b1c20",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "app"
    ],
    "category": "Business",
    "shortDescription": "Поиск потенциальных клиентов",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "leadgenerator"
        ]
      }
    }
  }
}
