{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Customers Beta",
  "mainBinaryName": "customers-beta",
  "identifier": "local.customers.beta",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Customers Beta",
        "width": 1360,
        "height": 860,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#1b1c20",
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "shortDescription": "Customers Beta — версия для проверки (отдельные данные и настройки)"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "customers-beta"
        ]
      }
    }
  }
}
