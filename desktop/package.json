{
  "name": "customers-desktop",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "shots": "node scripts/screenshots.cjs",
    "dev:beta": "tauri dev --features beta --config src-tauri/tauri.beta.conf.json",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "debug:build": "tauri build --features beta --config src-tauri/tauri.beta.conf.json",
    "debug:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked --features beta",
    "debug:scenario": "cargo test --manifest-path src-tauri/Cargo.toml --locked --features beta --test scenarios -- --nocapture",
    "debug:isolation": "cargo test --manifest-path src-tauri/Cargo.toml --locked --lib -- channel:: paths:: other_channel beta_ crash_reports_of_channels stable_never_picks_beta secrets::tests::stable_secrets",
    "database:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked --lib -- db:: store::",
    "release:check": "node scripts/release-check.cjs",
    "release:build": "tauri build",
    "check": "npm run typecheck && npm test && npm run test:core && npm run debug:test && npm run release:check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
