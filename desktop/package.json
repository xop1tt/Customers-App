{
  "name": "customers-desktop",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "shots": "node scripts/screenshots.cjs",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "database:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked --lib -- db:: store::",
    "release:check": "node scripts/release-check.cjs",
    "release:build": "tauri build",
    "e2e": "node e2e/run.cjs",
    "check": "npm run typecheck && npm test && npm run test:core && npm run release:check",
    "golden": "vitest run src/golden",
    "golden:update": "vitest run src/golden -u",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
