<UserControl
    x:Class="Customers.Ui.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageStack" Padding="24,8,24,32" Spacing="16">
            <StackPanel Spacing="2">
                <TextBlock x:Name="Greeting" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="Summary" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>

            <!-- Показатели: нажатие открывает соответствующий раздел -->
            <Grid x:Name="Stats" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Tag="All" Click="OnStatClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="TotalNumber" Style="{StaticResource TitleLargeTextBlockStyle}" />
                        <TextBlock Text="Всего лидов" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Tag="New" Click="OnStatClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="NewNumber" Style="{StaticResource TitleLargeTextBlockStyle}" />
                        <TextBlock Text="Новые" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Tag="All" Click="OnStatClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="HighNumber" Style="{StaticResource TitleLargeTextBlockStyle}" />
                        <TextBlock Text="Высокая релевантность" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Tag="Favorites" Click="OnStatClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="FavoriteNumber" Style="{StaticResource TitleLargeTextBlockStyle}" />
                        <TextBlock Text="В избранном" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Поиск -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Поиск" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                        <TextBlock x:Name="SearchStatus" TextWrapping="Wrap" />
                        <ProgressBar x:Name="SearchBar" IsIndeterminate="True" Visibility="Collapsed" />
                    </StackPanel>
                    <Button x:Name="FindButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnFindClick" VerticalAlignment="Center" MinWidth="140" />
                </Grid>
            </Border>

            <Grid x:Name="Lower" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="TopCard" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Лучшие новые лиды" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                        <StackPanel x:Name="TopLeads" Spacing="2" />
                    </StackPanel>
                </Border>
                <Border x:Name="SourcesCard" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Источники" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                        <StackPanel x:Name="SourceStatus" Spacing="8" />
                        <HyperlinkButton Content="Управление источниками" Click="OnSourcesClick" Padding="0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="Onboarding" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="С чего начать" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                    <TextBlock TextWrapping="Wrap" Text="1. Нажмите «Найти лиды» — приложение обойдёт включённые источники: ленты заказов, публичные каналы Telegram и карту организаций." />
                    <TextBlock TextWrapping="Wrap" Text="2. Откройте лид: справа видно оценку и её причины, контакты и кнопки «Позвонить» и «Написать»." />
                    <TextBlock TextWrapping="Wrap" Text="3. Отметьте нужное звездой, ненужное исключите — домены, телефоны и названия больше не вернутся." />
                    <TextBlock TextWrapping="Wrap" Text="4. Чтобы лиды были и на других компьютерах, войдите в облачную учётную запись в настройках." Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
